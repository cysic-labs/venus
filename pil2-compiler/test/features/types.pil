function get_type_code(const expr c): int {
        if (c is int) {
            return 1;
        }
        if (c is string) {
            return 2;
        }
        if (c is expr) {
            return 3;
        }
        if (c is col fixed) {
            return 4;
        }
        if (c is col witness) {
            return 5;
        }
        if (c is airval) {
            return 6;
        }
        if (c is proofval) {
            return 7;
        }
        if (c is public) {
            return 8;
        }
        if (c is challenge) {
            return 9;
        }
        if (c is airgroupval) {
            return 10;
        }
        if (c is col custom) {
            return 11;
        }
        return 0;
}

